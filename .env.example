# SnackValue Agent 环境变量样例（复制为 .env 使用）
# 全部可选：一个都不配置时 = 本地免费开放模式，与 V0.3 行为一致。

# ---------- 商业化 / 托管部署（V0.4） ----------
# API Key 认证：逗号分隔的授权 key 列表。配置后所有 /api/*（除 /api/health）
# 都要求请求头 X-API-Key。留空 = 不认证。
SNACKVALUE_API_KEYS=

# 每 key 每日计量端点（compare / extract / extract_text）调用上限。0 = 不限量。
SNACKVALUE_DAILY_QUOTA=0

# 允许跨域的来源（逗号分隔），给独立前端 / 小程序 H5 用。留空 = 不开 CORS。
SNACKVALUE_CORS_ORIGINS=

# SQLite 数据库路径。容器部署时指向挂载卷；留空 = 项目内 data/snack_history.db。
SNACKVALUE_DB_PATH=

# ---------- 云端 OCR（可选） ----------
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# ---------- OCR 调优 ----------
OCR_TIMEOUT_SECONDS=20
CLOUD_OCR_TIMEOUT_SECONDS=30
LOCAL_OCR_MAX_CONCURRENCY=1
MAX_IMAGE_SIZE_BYTES=10485760
